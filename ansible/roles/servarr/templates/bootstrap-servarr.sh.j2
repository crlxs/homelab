#!/bin/sh
set -eu

# Runs as a one-shot command in the SABnzbd LXC. Secrets arrive only on stdin.
RADARR_URL={{ ('http://' ~ servarr_endpoints.radarr ~ ':' ~ servarr_ports.radarr) | quote }}
SONARR_URL={{ ('http://' ~ servarr_endpoints.sonarr ~ ':' ~ servarr_ports.sonarr) | quote }}
PROWLARR_URL={{ ('http://' ~ servarr_endpoints.prowlarr ~ ':' ~ servarr_ports.prowlarr) | quote }}
SABNZBD_URL={{ ('http://localhost:' ~ sabnzbd_web_port) | quote }}
SABNZBD_HOST={{ servarr_endpoints.sabnzbd | quote }}
SABNZBD_PORT={{ sabnzbd_web_port | string | quote }}
SERVARR_UI_USERNAME={{ servarr_ui_username | quote }}
RADARR_ROOT_FOLDER={{ radarr_root_folder | quote }}
SONARR_ROOT_FOLDER={{ sonarr_root_folder | quote }}
NZBGEEK_NAME={{ nzbgeek_indexer_name | quote }}
NZBGEEK_URL={{ nzbgeek_base_url | quote }}
changed=0
bootstrap_input="$(cat)"
value() { printf '%s' "$bootstrap_input" | jq -er --arg key "$1" '.[$key]'; }
password="$(value servarr_ui_password)"
radarr_key="$(value radarr_api_key)"
sonarr_key="$(value sonarr_api_key)"
prowlarr_key="$(value prowlarr_api_key)"
sabnzbd_key="$(value sabnzbd_api_key)"

request() { curl -fsS --connect-timeout 5 --max-time 30 "$@"; }

wait_for_url() {
  attempts=0
  until curl -fsS --connect-timeout 2 --max-time 3 "$1" >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 60 ]; then
      printf 'Timed out waiting for %s\n' "$1" >&2
      exit 1
    fi
    sleep 2
  done
}

configure_auth() {
  url="$1"; version="$2"; key="$3"
  config="$(request -H "X-Api-Key: $key" "$url/api/$version/config/host")"
  # Preserve existing accounts instead of resetting their password on reruns.
  if [ -n "$(printf '%s' "$config" | jq -r '.username // empty')" ]; then return; fi
  updated="$(printf '%s' "$config" | jq \
    --arg username "$SERVARR_UI_USERNAME" --arg password "$password" \
    '.authenticationMethod = "forms" | .authenticationRequired = "enabled" |
     .username = $username | .password = $password | .passwordConfirmation = $password')"
  id="$(printf '%s' "$config" | jq -r '.id')"
  printf '%s' "$updated" | request -X PUT -H 'Content-Type: application/json' \
    -H "X-Api-Key: $key" --data-binary @- "$url/api/$version/config/host/$id" >/dev/null
  printf 'Updated Arr authentication\n' >&2
  changed=1
}

# Update only fields owned by this bootstrap, preserving other provider fields.
merge_fields() {
  jq --argjson fields "$1" '
    .fields = ((.fields // []) as $old |
      [$old[] | .name as $n | ($fields | map(select(.name == $n))) as $new |
        if ($new | length) > 0 then .value = $new[0].value else . end] +
      [$fields[] | .name as $n | select($old | all(.name != $n))])'
}

# Arr may omit empty values on GET and add schema metadata. Compare only the
# desired field values, treating an omitted/null optional string as empty.
fields_match() {
  jq -e --argjson wanted "$1" '(.fields // []) as $current | $wanted | all(
    .name as $name | .value as $value |
    ($current | map(select(.name == $name))[0].value) as $old |
    if $name == "apiKey" and $old == "********" then true
    else (if $old == null then "" else $old end) == $value end)' >/dev/null
}

# Providers return a mask instead of the saved key. Their read-only test API
# resolves the mask back to the stored secret: keep working credentials, repair
# stale ones when the source service's key has been rotated, without a key file.
provider_matches() {
  current="$1"; fields="$2"; url="$3"; version="$4"; key="$5"; resource="$6"
  if ! printf '%s' "$current" | fields_match "$fields"; then return 1; fi
  if printf '%s' "$current" | jq -e 'any(.fields[]; .name == "apiKey" and .value == "********")' >/dev/null; then
    printf '%s' "$current" | request -X POST -H 'Content-Type: application/json' \
      -H "X-Api-Key: $key" --data-binary @- "$url/api/$version/$resource/test" >/dev/null 2>&1
  fi
}

register_nzbgeek() {
  existing="$(request -H "X-Api-Key: $prowlarr_key" "$PROWLARR_URL/api/v1/indexer")"
  current="$(printf '%s' "$existing" | jq -c --arg name "$NZBGEEK_NAME" \
    '[.[] | select(.name == $name and .implementation == "Newznab")][0] // empty')"
  # Preserve a differently named, manually configured NZBGeek indexer.
  if [ -z "$current" ] && printf '%s' "$existing" | jq -e --arg url "$NZBGEEK_URL" \
    'any(.[]; .implementation == "Newznab" and any(.fields[]; .name == "baseUrl" and .value == $url))' >/dev/null; then return; fi
  fields="$(jq -n --arg url "$NZBGEEK_URL" --arg key "$(value nzbgeek_api_key)" \
    '[{name: "baseUrl", value: $url}, {name: "apiKey", value: $key}]')"
  if [ -n "$current" ]; then
    updated="$(printf '%s' "$current" | merge_fields "$fields")"
    if provider_matches "$current" "$fields" "$PROWLARR_URL" v1 "$prowlarr_key" indexer; then return; fi
    method=PUT; endpoint="$PROWLARR_URL/api/v1/indexer/$(printf '%s' "$current" | jq -r '.id')"
  else
    schema="$(request -H "X-Api-Key: $prowlarr_key" "$PROWLARR_URL/api/v1/indexer/schema" |
      jq -ce '[.[] | select(.implementation == "Newznab" and (.name | ascii_downcase) == "nzbgeek")][0] // error("NZBGeek schema not found")')"
    profile="$(request -H "X-Api-Key: $prowlarr_key" "$PROWLARR_URL/api/v1/appprofile" |
      jq -er '[.[] | select(.enableRss and .enableAutomaticSearch and .enableInteractiveSearch)][0].id // error("No enabled indexer sync profile")')"
    updated="$(printf '%s' "$schema" | merge_fields "$fields" |
      jq --arg name "$NZBGEEK_NAME" --argjson profile "$profile" 'del(.id) | .name = $name | .appProfileId = $profile | .enable = true')"
    method=POST; endpoint="$PROWLARR_URL/api/v1/indexer"
  fi
  printf '%s' "$updated" | request -X "$method" -H 'Content-Type: application/json' \
    -H "X-Api-Key: $prowlarr_key" --data-binary @- "$endpoint" >/dev/null
  printf '{"name":"ApplicationIndexerSync"}' | request -X POST -H 'Content-Type: application/json' \
    -H "X-Api-Key: $prowlarr_key" --data-binary @- "$PROWLARR_URL/api/v1/command" >/dev/null
  printf 'Updated NZBGeek indexer\n' >&2
  changed=1
}

register_application() {
  name="$1"; implementation="$2"; contract="$3"; base_url="$4"; app_key="$5"; categories="$6"
  existing="$(request -H "X-Api-Key: $prowlarr_key" "$PROWLARR_URL/api/v1/applications")"
  current="$(printf '%s' "$existing" | jq -c --arg name "$name" --arg impl "$implementation" \
    '[.[] | select(.name == $name and .implementation == $impl)][0] // empty')"
  fields="$(jq -n --arg prowlarr "$PROWLARR_URL" --arg base_url "$base_url" \
    --arg api_key "$app_key" --argjson categories "$categories" '[
      {name: "prowlarrUrl", value: $prowlarr}, {name: "baseUrl", value: $base_url},
      {name: "apiKey", value: $api_key}, {name: "syncCategories", value: $categories}]')"
  if [ -n "$current" ]; then
    updated="$(printf '%s' "$current" | merge_fields "$fields")"
    if provider_matches "$current" "$fields" "$PROWLARR_URL" v1 "$prowlarr_key" applications; then return; fi
    id="$(printf '%s' "$current" | jq -r '.id')"
    method=PUT; endpoint="$PROWLARR_URL/api/v1/applications/$id"
  else
    updated="$(jq -n --arg name "$name" --arg impl "$implementation" --arg contract "$contract" \
      --argjson fields "$fields" '{name: $name, implementation: $impl, configContract: $contract,
        syncLevel: "fullSync", fields: $fields}')"
    method=POST; endpoint="$PROWLARR_URL/api/v1/applications"
  fi
  printf '%s' "$updated" | request -X "$method" -H 'Content-Type: application/json' \
    -H "X-Api-Key: $prowlarr_key" --data-binary @- "$endpoint" >/dev/null
  printf 'Updated Prowlarr application\n' >&2
  changed=1
}

register_download_client() {
  url="$1"; version="$2"; key="$3"; category_field="$4"; category="$5"; remove_completed="$6"
  existing="$(request -H "X-Api-Key: $key" "$url/api/$version/downloadclient")"
  current="$(printf '%s' "$existing" | jq -c \
    '[.[] | select(.implementation == "Sabnzbd" and .name == "SABnzbd")][0] // empty')"
  # A differently named SAB client is user-managed; do not create a duplicate.
  if [ -z "$current" ] && printf '%s' "$existing" | jq -e 'any(.[]; .implementation == "Sabnzbd")' >/dev/null; then return; fi
  fields="$(jq -n --arg host "$SABNZBD_HOST" --argjson port "$SABNZBD_PORT" \
    --arg api_key "$sabnzbd_key" --arg category_field "$category_field" --arg category "$category" '[
      {name: "host", value: $host}, {name: "port", value: $port}, {name: "useSsl", value: false},
      {name: "urlBase", value: ""}, {name: "apiKey", value: $api_key}, {name: $category_field, value: $category}]')"
  if [ -n "$current" ]; then
    updated="$(printf '%s' "$current" | merge_fields "$fields")"
    if provider_matches "$current" "$fields" "$url" "$version" "$key" downloadclient; then return; fi
    id="$(printf '%s' "$current" | jq -r '.id')"
    method=PUT; endpoint="$url/api/$version/downloadclient/$id"
  else
    updated="$(jq -n --argjson fields "$fields" --argjson remove_completed "$remove_completed" '{
      name: "SABnzbd", enable: true, protocol: "usenet", priority: 1,
      removeCompletedDownloads: $remove_completed, removeFailedDownloads: true,
      implementation: "Sabnzbd", configContract: "SabnzbdSettings", fields: $fields}')"
    method=POST; endpoint="$url/api/$version/downloadclient"
  fi
  printf '%s' "$updated" | request -X "$method" -H 'Content-Type: application/json' \
    -H "X-Api-Key: $key" --data-binary @- "$endpoint" >/dev/null
  printf 'Updated Arr download client\n' >&2
  changed=1
}

ensure_root_folder() {
  url="$1"; key="$2"; path="$3"
  existing="$(request -H "X-Api-Key: $key" "$url/api/v3/rootfolder")"
  if printf '%s' "$existing" | jq -e --arg path "$path" 'any(.[]; .path == $path)' >/dev/null; then return; fi
  jq -n --arg path "$path" '{path: $path}' | request -X POST -H 'Content-Type: application/json' \
    -H "X-Api-Key: $key" --data-binary @- "$url/api/v3/rootfolder" >/dev/null
  printf 'Updated Arr root folder\n' >&2
  changed=1
}

# Form data (including passwords) is passed through stdin, not curl arguments.
sabnzbd_request() {
  printf '%s' "$1" | jq -r --arg apikey "$sabnzbd_key" \
    '. + {apikey: $apikey, output: "json"} | to_entries |
      map((.key | @uri) + "=" + (.value | tostring | @uri)) | join("&")' |
    request --data-binary @- "$SABNZBD_URL/api"
}

sabnzbd_set_misc() {
  keyword="$1"; desired="$2"
  query="$(jq -n --arg keyword "$keyword" '{mode: "get_config", section: "misc", keyword: $keyword}')"
  current="$(sabnzbd_request "$query")"
  if [ "$(printf '%s' "$current" | jq -r --arg key "$keyword" '.config.misc[$key] | tostring')" = "$desired" ]; then return; fi
  query="$(jq -n --arg keyword "$keyword" --arg value "$desired" \
    '{mode: "set_config", section: "misc", keyword: $keyword, value: $value}')"
  response="$(sabnzbd_request "$query")"
  printf '%s' "$response" | jq -e '.status != false and .config != null' >/dev/null
  printf 'Updated SABnzbd misc %s\n' "$keyword" >&2
  changed=1
}

sabnzbd_set_entry() {
  section="$1"; desired="$2"
  name="$(printf '%s' "$desired" | jq -r '.name')"
  query="$(jq -n --arg section "$section" --arg keyword "$name" \
    '{mode: "get_config", section: $section, keyword: $keyword}')"
  current="$(sabnzbd_request "$query")"
  # SAB masks passwords: preserve established provider credentials on reruns.
  if printf '%s' "$current" | jq -e --arg section "$section" --argjson desired "$desired" '
    .config[$section][0] as $current | $current != null and
      ($desired | to_entries | all(.key == "password" or
        (($current[.key] | tostring) == (.value | tostring))))' >/dev/null; then return; fi
  query="$(printf '%s' "$desired" | jq --arg section "$section" --argjson current "$current" '
    (if $current.config[$section][0] != null then del(.password) else . end) +
    {mode: "set_config", section: $section}')"
  response="$(sabnzbd_request "$query")"
  printf '%s' "$response" | jq -e '.status != false and .config != null' >/dev/null
  printf 'Updated SABnzbd %s entry\n' "$section" >&2
  changed=1
}

sabnzbd_set_provider() {
  provider_desired="$1"
  provider_servers="$(sabnzbd_request '{"mode":"get_config","section":"servers"}')"
  if ! printf '%s' "$provider_servers" | jq -e '
    .status != false and (.config.servers | type == "array") and
    (.config.servers | all(.[]; (.name | type == "string") and (.name | length > 0)))' >/dev/null; then
    printf 'Invalid SABnzbd server-list response; refusing to create a provider\n' >&2
    exit 1
  fi
  # Account identity is independent of the label, port and SSL settings.
  # Hostnames are case-insensitive; usernames must match exactly.
  provider_account_matches="$(printf '%s' "$provider_servers" | jq -c --argjson desired "$provider_desired" '
    def hostname: ascii_downcase | rtrimstr(".");
    [.config.servers[] | select(
      ((.host // "") | hostname) == ($desired.host | hostname) and
      (.username // "") == $desired.username)] |
    sort_by([if .name == $desired.name then 0 else 1 end,
             if (.enable | tostring) == "1" or (.enable | tostring) == "true" then 0 else 1 end,
             .name])')"
  provider_selected="$(printf '%s' "$provider_account_matches" | jq -r '.[0].name // empty')"
  if [ -z "$provider_selected" ]; then
    # A name collision must not repurpose another account or retain its password.
    if printf '%s' "$provider_servers" | jq -e --argjson desired "$provider_desired" \
      'any(.config.servers[]; .name == $desired.name)' >/dev/null; then
      printf 'Configured SABnzbd provider name belongs to a different host/account; choose a unique sabnzbd_provider_name\n' >&2
      exit 1
    fi
    sabnzbd_set_entry servers "$provider_desired"
    return
  fi
  # Disable redundant entries before enabling/updating the selected account.
  # Keep their configuration for recovery, including saved (masked) passwords.
  provider_duplicates="$(printf '%s' "$provider_account_matches" | jq -c '.[1:] |
    map(select((.enable | tostring) == "1" or (.enable | tostring) == "true"))')"
  while [ "$(printf '%s' "$provider_duplicates" | jq 'length')" -gt 0 ]; do
    provider_disabled="$(printf '%s' "$provider_duplicates" | jq -c '.[0] | {name: .name, enable: 0}')"
    sabnzbd_set_entry servers "$provider_disabled"
    provider_duplicates="$(printf '%s' "$provider_duplicates" | jq -c '.[1:]')"
  done
  provider_desired="$(printf '%s' "$provider_desired" | jq --arg name "$provider_selected" '.name = $name')"
  sabnzbd_set_entry servers "$provider_desired"
}

wait_for_url "$RADARR_URL/ping"
wait_for_url "$SONARR_URL/ping"
wait_for_url "$PROWLARR_URL/ping"
# Loopback access keeps SAB's hostname protection enabled.
wait_for_url "$SABNZBD_URL/api?mode=version"

configure_auth "$RADARR_URL" v3 "$radarr_key"
configure_auth "$SONARR_URL" v3 "$sonarr_key"
configure_auth "$PROWLARR_URL" v1 "$prowlarr_key"
ensure_root_folder "$RADARR_URL" "$radarr_key" "$RADARR_ROOT_FOLDER"
ensure_root_folder "$SONARR_URL" "$sonarr_key" "$SONARR_ROOT_FOLDER"

sabnzbd_set_misc download_dir "$(value sabnzbd_incomplete_dir)"
sabnzbd_set_misc complete_dir "$(value sabnzbd_complete_dir)"
sabnzbd_set_misc permissions 775
for category_key in sabnzbd_radarr_category sabnzbd_sonarr_category sabnzbd_prowlarr_category; do
  category="$(value "$category_key")"
  desired="$(jq -n --arg category "$category" '{name: $category, dir: $category, pp: 3}')"
  sabnzbd_set_entry categories "$desired"
done
provider="$(printf '%s' "$bootstrap_input" | jq '{
  name: .sabnzbd_provider_name, host: .sabnzbd_provider_host,
  port: (.sabnzbd_provider_port | tonumber), username: .sabnzbd_provider_username,
  password: .sabnzbd_provider_password, connections: (.sabnzbd_provider_connections | tonumber),
  ssl: (if .sabnzbd_provider_ssl then 1 else 0 end), ssl_verify: .sabnzbd_provider_ssl_verify,
  priority: .sabnzbd_provider_priority, enable: 1}')"
sabnzbd_set_provider "$provider"
current="$(sabnzbd_request '{"mode":"get_config","section":"misc","keyword":"username"}')"
if [ -z "$(printf '%s' "$current" | jq -r '.config.misc.username // empty')" ]; then
  # Set password first, so a partial failure does not leave a username-only account.
  sabnzbd_set_misc password "$(value sabnzbd_ui_password)"
  sabnzbd_set_misc username "$(value sabnzbd_ui_username)"
fi

register_download_client "$RADARR_URL" v3 "$radarr_key" movieCategory "$(value sabnzbd_radarr_category)" true
register_download_client "$SONARR_URL" v3 "$sonarr_key" tvCategory "$(value sabnzbd_sonarr_category)" true
register_download_client "$PROWLARR_URL" v1 "$prowlarr_key" category "$(value sabnzbd_prowlarr_category)" false
register_application Radarr Radarr RadarrSettings "$RADARR_URL" "$radarr_key" '[2000,2010,2020,2030,2040,2045,2050,2060]'
register_application Sonarr Sonarr SonarrSettings "$SONARR_URL" "$sonarr_key" '[5000,5010,5020,5030,5040,5045,5050,5060]'
register_nzbgeek
if [ "$changed" -eq 1 ]; then printf 'CHANGED\n'; else printf 'OK\n'; fi
