services:
  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID={{ servarr_user }}
      - PGID={{ servarr_group }}
      - TZ={{ timezone }}
    volumes:
      - {{ servarr_conf_dir }}/prowlarr:/config
    ports:
      - 9696:9696
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl --fail --silent http://localhost:9696/ping || exit 1"]
      interval: 5s
      timeout: 3s
      retries: 30
  
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID={{ servarr_user }}
      - PGID={{ servarr_group }}
      - TZ={{ timezone }}
    volumes:
      - {{ servarr_conf_dir }}/radarr:/config
      - {{ media_dir }}:{{ media_dir }} # By making the internal path match the external one we avoid folder errors with SABnzbd.
    ports:
      - 7878:7878
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl --fail --silent http://localhost:7878/ping || exit 1"]
      interval: 5s
      timeout: 3s
      retries: 30

  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID={{ servarr_user }}
      - PGID={{ servarr_group }}
      - TZ={{ timezone }}
    volumes:
      - {{ servarr_conf_dir }}/sonarr:/config
      - {{ media_dir }}:{{ media_dir }}
    ports:
      - 8989:8989
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl --fail --silent http://localhost:8989/ping || exit 1"]
      interval: 5s
      timeout: 3s
      retries: 30

  servarr-bootstrap:
    image: alpine:3.21
    container_name: servarr-bootstrap
    depends_on:
      prowlarr:
        condition: service_healthy
      radarr:
        condition: service_healthy
      sonarr:
        condition: service_healthy
    environment:
      SERVARR_UI_USERNAME: "{{ servarr_ui_username }}"
    entrypoint: ["/bin/sh", "/bootstrap-servarr.sh"]
    volumes:
      - {{ servarr_conf_dir }}/bootstrap-servarr.sh:/bootstrap-servarr.sh:ro
      - {{ servarr_conf_dir }}/prowlarr:/config/prowlarr:ro
      - {{ servarr_conf_dir }}/radarr:/config/radarr:ro
      - {{ servarr_conf_dir }}/sonarr:/config/sonarr:ro
    secrets:
      - servarr_ui_password
    restart: "no"

#  lidarr:
#    image: lscr.io/linuxserver/lidarr:latest
#    container_name: lidarr
#    environment:
#      - PUID=${PUID}
#      - PGID=${PGID}
#      - TZ=${TZ}
#    volumes:
#      - ${SERVARR_CONF_DIR}/lidarr:/config
#    ports:
#      - 8686:8686
#    restart: unless-stopped

  jellyseerr:
    image: ghcr.io/fallenbagel/jellyseerr:latest
    init: true
    container_name: jellyseerr
    environment:
      - PUID={{ servarr_user }}
      - PGID={{ servarr_group }}
      - TZ={{ timezone }}
    volumes:
      - {{ servarr_conf_dir }}/jellyseerr:/app/config
    ports:
      - 5055:5055
    restart: unless-stopped

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest # Use a specific version for stability
    container_name: cadvisor
    ports:
      - 8080:8080
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    devices:
      - /dev/kmsg
    restart: unless-stopped
    privileged: true # Often required on modern kernels to access cgroup data

secrets:
  servarr_ui_password:
    file: "{{ servarr_conf_dir }}/secrets/ui_password"

